# ==============================================================================
# VioreCert Server & Infrastructure Monitoring - Environment Configuration
# ==============================================================================

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/monitoring_domain?schema=public"

# Authentication & Session Secrets
JWT_SECRET="ganti-dengan-rahasia-jwt-acak-yang-kuat-minimal-32-karakter"
AUTH_SECRET="ganti-dengan-rahasia-auth-acak-yang-kuat"

# Base URL Aplikasi Dashboard
PORT=3001
APP_BASE_URL="http://localhost:3001"
NEXT_PUBLIC_APP_NAME="VioreCert Infrastructure Monitor"
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Agent Ingestion Security (Opsional global HMAC / Salt)
AGENT_INGEST_SECRET="rahasia-ingest-agent-terpisah"

# Biznet Cloud API Integration (Server-side Only)
BIZNET_API_BASE_URL="https://api.portal.biznetgio.com/v1"
BIZNET_API_KEY=""
BIZNET_API_TIMEOUT_MS=10000

# Telegram Incident Alert Channel
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Email (SMTP) Alert Channel (Opsional)
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""

# Monitoring Configuration
SSL_CHECK_TIMEOUT_MS=9000
