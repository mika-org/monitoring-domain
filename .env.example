# ==============================================================================
# CertPulse - Template Environment Configuration (.env.example)
# ==============================================================================

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/monitoring_domain?schema=public"

# Rahasia JWT Session
JWT_SECRET="ganti-dengan-rahasia-jwt-acak-yang-kuat"

# Port server Next.js
PORT=3001

# Informasi Aplikasi Publik
NEXT_PUBLIC_APP_NAME="CertPulse"
NEXT_PUBLIC_APP_DESCRIPTION="Monitoring Masa Aktif SSL Domain & Studio QR Code Realtime"
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Batas waktu timeout socket koneksi TLS/SSL (milidetik)
SSL_CHECK_TIMEOUT_MS=9000
